rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Só a conta do administrador pode alterar dados.
    // Antes: qualquer usuário logado podia criar, editar e apagar eventos.
    function isAdmin() {
      // UID da conta admin (Firebase > Authentication > Users > User UID).
      // Mesmo valor de ADMIN_UIDS no index.html.
      return request.auth != null
        && request.auth.uid in ['COLE_AQUI_O_UID_DO_ADMIN'];
    }

    match /eventos/{eventoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
