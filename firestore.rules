rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // UID da conta admin (Firebase > Authentication > Users > User UID).
      // Mesmo valor de ADMIN_UIDS em src/lib/firebase.js.
      // Também vale a conta Google luisfmrtns@gmail.com (e-mail verificado). Mesmo valor de ADMIN_EMAILS.
      return request.auth != null
        && (request.auth.uid in ['1rDi2JoNIuNa7ssJ8uP6YnmxSaI2']
          || (request.auth.token.email == 'luisfmrtns@gmail.com' && request.auth.token.email_verified == true));
    }

    function texto(campo, max) {
      return !(campo in request.resource.data) || request.resource.data[campo] == null
        || (request.resource.data[campo] is string && request.resource.data[campo].size() <= max);
    }

    // Link de site: vazio ou começando com http:// ou https:// (bloqueia "javascript:" e afins).
    function link(campo) {
      return !(campo in request.resource.data) || request.resource.data[campo] == null
        || request.resource.data[campo] == ''
        || (request.resource.data[campo] is string && request.resource.data[campo].size() <= 500
          && request.resource.data[campo].matches('^https?://.+'));
    }

    // Envio do formulário público: só cria, sempre como pendente, com campos limitados.
    function envioPublicoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['titulo', 'categoria', 'generos', 'inicio', 'fim', 'localNome', 'endereco', 'cidade',
          'lat', 'lng', 'descricao', 'cartazUrl', 'ingressoUrl', 'gratuito', 'preco', 'instagram', 'enviadoPor',
          'status', 'origem', 'criadoEm', 'atualizadoEm'])
        && d.status == 'pendente'
        && d.origem == 'formulario'
        && d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 120
        && d.inicio is timestamp && d.inicio > request.time - duration.value(1, 'd')
        && d.criadoEm == request.time
        && texto('categoria', 30) && texto('localNome', 120) && texto('endereco', 200) && texto('cidade', 80)
        && texto('descricao', 2000) && link('cartazUrl') && link('ingressoUrl')
        && texto('preco', 80) && texto('instagram', 60)
        && (d.generos == null || (d.generos is list && d.generos.size() <= 10))
        && d.enviadoPor is map && d.enviadoPor.keys().hasOnly(['nome', 'contato'])
        && d.enviadoPor.nome is string && d.enviadoPor.nome.size() <= 80
        && d.enviadoPor.contato is string && d.enviadoPor.contato.size() <= 120;
    }

    // Página oficial (bar, banda): quem é dono publica direto, sem passar pela aprovação.
    function envioPerfilValido() {
      let d = request.resource.data;
      return request.auth != null
        && d.keys().hasOnly(['titulo', 'categoria', 'generos', 'inicio', 'fim', 'localNome', 'endereco', 'cidade',
          'lat', 'lng', 'descricao', 'cartazUrl', 'ingressoUrl', 'gratuito', 'preco', 'instagram',
          'perfil', 'criadoPor', 'status', 'origem', 'criadoEm', 'atualizadoEm'])
        && d.status == 'publicado'
        && d.origem == 'perfil'
        && d.criadoPor == request.auth.uid
        && d.perfil is string && d.perfil.size() <= 120
        && exists(/databases/$(database)/documents/perfis/$(d.perfil))
        && request.auth.uid in get(/databases/$(database)/documents/perfis/$(d.perfil)).data.donos
        && d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 120
        && d.inicio is timestamp && d.inicio > request.time - duration.value(1, 'd')
        && d.criadoEm == request.time
        && texto('categoria', 30) && texto('localNome', 120) && texto('endereco', 200) && texto('cidade', 80)
        && texto('descricao', 2000) && link('cartazUrl') && link('ingressoUrl')
        && texto('preco', 80) && texto('instagram', 60)
        && (d.generos == null || (d.generos is list && d.generos.size() <= 10));
    }

    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /eventos/{eventoId} {
      // O público só vê eventos publicados. O admin vê todos (pendentes, ocultos).
      allow read: if resource.data.status == 'publicado' || isAdmin();
      allow create: if isAdmin() || envioPublicoValido() || envioPerfilValido();
      allow update: if isAdmin()
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.inicio is timestamp
        && request.resource.data.status in ['publicado', 'pendente', 'rascunho', 'rejeitado']
        // Evento publicado é aberto a todos: nome e contato de quem enviou ficam em contatosEnvio.
        && (request.resource.data.status != 'publicado'
          || (!('enviadoPor' in request.resource.data) && !('outrosEnvios' in request.resource.data)));
      allow delete: if isAdmin();
    }

    // Nome e contato de quem mandou o evento pelo formulário (tirado do evento ao publicar). Só o admin.
    match /contatosEnvio/{id} {
      allow read, write: if isAdmin();
    }

    // Contador de visitas: qualquer um registra (só cria, campos fixos); só o admin lê.
    function opcional(d, campo, max) {
      return d[campo] == null || (d[campo] is string && d[campo].size() <= max);
    }
    match /visitas/{id} {
      allow create: if request.resource.data.keys().hasOnly(['tipo', 'visitante', 'sessao', 'nova', 'origem', 'disp',
            'pagina', 'eventoId', 'acao', 'valor', 'em'])
        && request.resource.data.tipo in ['pagina', 'clique', 'filtro']
        && request.resource.data.em == request.time
        && request.resource.data.visitante is string && request.resource.data.visitante.size() <= 20
        && request.resource.data.sessao is string && request.resource.data.sessao.size() <= 20
        && request.resource.data.nova is bool
        && request.resource.data.origem is string && request.resource.data.origem.size() <= 40
        && request.resource.data.disp in ['celular', 'computador', 'tablet']
        && request.resource.data.pagina is string && request.resource.data.pagina.size() <= 200
        && opcional(request.resource.data, 'eventoId', 120)
        && opcional(request.resource.data, 'acao', 30)
        && opcional(request.resource.data, 'valor', 60);
      allow read, delete: if isAdmin();
    }

    // "Eu vou" / "Tenho interesse": um documento por pessoa e evento (id = eventoId_visitante).
    // Sem conta, visitante é o código do aparelho. Com conta Google, é o uid (e vem com uid e perfil).
    function presencaValida(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['eventoId', 'visitante', 'tipo', 'em', 'uid', 'perfil'])
        && d.tipo in ['vou', 'interesse']
        && d.eventoId is string && d.eventoId.size() <= 120
        && d.visitante is string && d.visitante.size() <= 40
        && id == d.eventoId + '_' + d.visitante
        && d.em == request.time
        && (d.get('uid', null) == null ? d.visitante.size() <= 20 : (dono(d.uid) && d.visitante == d.uid))
        && (d.get('perfil', null) == null || d.perfil is bool)
        && exists(/databases/$(database)/documents/eventos/$(d.eventoId));
    }
    // Quem vai em qual rolê é privado: cada um vê as próprias marcações e as dos amigos.
    // Marcações sem conta (código do aparelho, até 20 letras) continuam legíveis para trazer para a conta.
    // As contagens dos eventos vêm do robô (scripts/contagens.mjs).
    function amigoAceito(uid) {
      return request.auth != null && uid is string
        && get(/databases/$(database)/documents/amizades/$(par(request.auth.uid, uid))).data.status == 'aceita';
    }
    match /presencas/{id} {
      allow read: if resource.data.visitante.size() <= 20
        || (request.auth != null && resource.data.get('uid', null) == request.auth.uid)
        || amigoAceito(resource.data.get('uid', null))
        || isAdmin();
      allow create: if presencaValida(id);
      allow update: if presencaValida(id)
        && (resource.data.get('uid', null) == null || dono(resource.data.uid));
      allow delete: if resource.data.get('uid', null) == null || dono(resource.data.uid);
    }

    // Conta do público: nome, foto e se aparece em "quem vai". Os outros só veem quem deixou público.
    // Última cidade escolhida na agenda, por conta. Só a própria pessoa lê e grava (não fica no perfil público).
    match /preferencias/{uid} {
      allow read: if dono(uid);
      allow create, update: if dono(uid)
        && request.resource.data.keys().hasOnly(['cidade', 'em'])
        && request.resource.data.cidade is string && request.resource.data.cidade.size() <= 60;
    }

    // Id da amizade entre duas contas: os dois uids em ordem, separados por _.
    function par(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    // Perfil fechado: amigos se veem; num pedido pendente, só quem RECEBEU vê quem pediu.
    // (Mandar um pedido não abre o perfil fechado de ninguém.)
    function amigoOuPedido(uid) {
      let caminho = /databases/$(database)/documents/amizades/$(par(request.auth.uid, uid));
      return request.auth != null && exists(caminho)
        && (get(caminho).data.status == 'aceita' || get(caminho).data.de == uid);
    }

    match /usuarios/{uid} {
      allow read: if resource.data.publico == true || dono(uid) || isAdmin() || amigoOuPedido(uid);
      allow create, update: if dono(uid)
        && request.resource.data.keys().hasOnly(['nome', 'busca', 'foto', 'publico', 'criadoEm', 'atualizadoEm'])
        && (!('busca' in request.resource.data) || (request.resource.data.busca is string && request.resource.data.busca.size() <= 60))
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 60
        && request.resource.data.foto is string && request.resource.data.foto.size() <= 500
        && request.resource.data.publico is bool;
    }

    // Amizade entre duas contas (id = os dois uids em ordem). Quem pede cria como pendente;
    // só quem recebeu aceita; qualquer um dos dois recusa, cancela ou desfaz (apaga).
    match /amizades/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.uids;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uids', 'de', 'para', 'status', 'em'])
        && request.resource.data.de == request.auth.uid
        && request.resource.data.para is string && request.resource.data.para.size() > 0 && request.resource.data.para.size() <= 128
        && request.resource.data.para != request.auth.uid
        && id == par(request.auth.uid, request.resource.data.para)
        && request.resource.data.uids == (request.auth.uid < request.resource.data.para
          ? [request.auth.uid, request.resource.data.para] : [request.resource.data.para, request.auth.uid])
        && request.resource.data.status == 'pendente'
        && request.resource.data.em == request.time
        && exists(/databases/$(database)/documents/usuarios/$(request.resource.data.para));
      allow update: if request.auth != null
        && resource.data.status == 'pendente'
        && resource.data.para == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'aceitaEm'])
        && request.resource.data.status == 'aceita'
        && request.resource.data.aceitaEm == request.time;
      allow delete: if request.auth != null && request.auth.uid in resource.data.uids;
    }

    // "Bora?": convite de um amigo para um evento. id = eventoId_de_para.
    // Só entre amigos (amizade aceita) e para evento publicado. Quem recebeu marca como visto.
    match /convites/{id} {
      allow read: if request.auth != null
        && (resource.data.de == request.auth.uid || resource.data.para == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['eventoId', 'de', 'para', 'visto', 'em'])
        && request.resource.data.de == request.auth.uid
        && request.resource.data.para is string && request.resource.data.para != request.auth.uid
        && request.resource.data.eventoId is string && request.resource.data.eventoId.size() <= 120
        && id == request.resource.data.eventoId + '_' + request.auth.uid + '_' + request.resource.data.para
        && request.resource.data.visto == false
        && request.resource.data.em == request.time
        && get(/databases/$(database)/documents/eventos/$(request.resource.data.eventoId)).data.status == 'publicado'
        && get(/databases/$(database)/documents/amizades/$(par(request.auth.uid, request.resource.data.para))).data.status == 'aceita';
      allow update: if request.auth != null
        && resource.data.para == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visto'])
        && request.resource.data.visto == true;
      allow delete: if request.auth != null
        && (resource.data.de == request.auth.uid || resource.data.para == request.auth.uid);
    }

    // Página oficial de um bar ou banda: quem cuida dela (donos) é definido pelo admin.
    match /perfis/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pedido para cuidar de uma página: a pessoa cria, o admin aprova ou recusa.
    match /pedidos/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['slug', 'nome', 'tipo', 'uid', 'contato', 'mensagem', 'status', 'em'])
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.slug + '_' + request.auth.uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.tipo in ['local', 'atracao']
        && request.resource.data.slug is string && request.resource.data.slug.size() <= 120
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 120
        && request.resource.data.contato is string && request.resource.data.contato.size() <= 120
        && request.resource.data.mensagem is string && request.resource.data.mensagem.size() <= 500
        && request.resource.data.em == request.time
        && !exists(/databases/$(database)/documents/pedidos/$(id));
      allow update, delete: if isAdmin();
    }

    // Quem segue cada bar ou banda (para avisar de evento novo).
    match /seguidores/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['slug', 'uid', 'nome', 'em'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.slug is string && request.resource.data.slug.size() <= 120
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 120
        && id == request.resource.data.slug + '_' + request.auth.uid
        && request.resource.data.em == request.time;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // "Tô aqui": um por pessoa e evento, só na hora do rolê (30 min antes até o fim; sem fim, 8h depois).
    function checkinValido(eventoId, uid) {
      let ev = get(/databases/$(database)/documents/eventos/$(eventoId)).data;
      return request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['eventoId', 'uid', 'em'])
        && request.resource.data.eventoId == eventoId && request.resource.data.uid == uid
        && request.resource.data.em == request.time
        && ev.status == 'publicado'
        && request.time >= ev.inicio - duration.value(30, 'm')
        && request.time <= ('fim' in ev && ev.fim is timestamp ? ev.fim : ev.inicio + duration.value(8, 'h'));
    }
    match /checkins/{id} {
      allow create: if id == request.resource.data.eventoId + '_' + request.resource.data.uid
        && checkinValido(request.resource.data.eventoId, request.resource.data.uid);
      allow read, delete: if (request.auth != null && resource.data.uid == request.auth.uid) || isAdmin();
    }
    // Ranking do mês, montado pelo robô. Todo mundo lê, ninguém escreve pelo site.
    // Sugestões de amigos ("Talvez você conheça"), montadas pelo robô. Só a própria pessoa lê.
    match /sugestoes/{uid} {
      allow read: if dono(uid);
      allow write: if false;
    }
    match /ranking/{mes} {
      allow read: if true;
      allow write: if false;
    }

    // Aparelhos do admin que recebem aviso de evento ou pedido novo (app do painel).
    match /avisosAdmin/{uid} {
      allow read: if isAdmin() && request.auth.uid == uid;
      allow create, update: if isAdmin() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['tokens', 'em'])
        && request.resource.data.tokens is list && request.resource.data.tokens.size() <= 10;
      allow delete: if isAdmin() && request.auth.uid == uid;
    }

    // Endereços de notificação dos aparelhos de cada conta. Só o robô (servidor) lê.
    match /aparelhos/{uid} {
      allow read: if false;
      allow create, update: if dono(uid)
        && request.resource.data.keys().hasOnly(['tokens', 'em'])
        && request.resource.data.tokens is list && request.resource.data.tokens.size() <= 10
        && request.resource.data.em == request.time;
    }

    match /lembretes/{id} {
      allow read: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['eventoId', 'visitante', 'token', 'em'])
        && request.resource.data.eventoId is string && request.resource.data.eventoId.size() <= 120
        && request.resource.data.visitante is string && request.resource.data.visitante.size() <= 20
        && request.resource.data.token is string && request.resource.data.token.size() <= 4096
        && id == request.resource.data.eventoId + '_' + request.resource.data.visitante
        && request.resource.data.em == request.time
        && exists(/databases/$(database)/documents/eventos/$(request.resource.data.eventoId));
      allow delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
